{
  "folders": [
    {
      "name": "client",
      "path": "./client"
    },
    {
      "name": "server",
      "path": "./server"
    }
  ],
  "settings": {
    "terminal.integrated.env.windows": {
      "DB_PASSWORD": "pass"
    },
    "editor.formatOnSave": true,
    "sqltools.connections": [
      {
        "ssh": "Disabled",
        "previewLimit": 50,
        "server": "localhost",
        "port": 5432,
        "driver": "PostgreSQL",
        "name": "trevi",
        "database": "server",
        "username": "root"
      }
    ],
    "emeraldwalk.runonsave": {
      "commands": [
        {
          "match": ".*database/migrations/.*\\.php$",
          "cmd": "cd server && php artisan ide-helper:models -RW"
        }
      ]
    }
  },
}
